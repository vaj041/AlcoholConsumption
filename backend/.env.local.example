# Local development uses SQLite. The path is relative to prisma/sqlite/schema.prisma.
DATABASE_URL="file:../dev.db"

JWT_SECRET="local-development-secret-change-before-deploy"
PORT=3001
NODE_ENV=development
DEFAULT_ADMIN_EMAIL="st.vajs@seznam.cz"
DEFAULT_ADMIN_PASSWORD="xxxxxx"

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Password reset requires a Mailjet account and verified sender.
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAILJET_FROM_EMAIL=""
MAILJET_FROM_NAME="Alcohol Tracker"
APP_BASE_URL="http://localhost:5173"
