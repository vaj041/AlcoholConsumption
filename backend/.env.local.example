# Local development uses SQLite. The path is relative to prisma/sqlite/schema.prisma.
DATABASE_URL="file:../dev.db"

JWT_SECRET="local-development-secret-change-before-deploy"
PORT=3001
NODE_ENV=development
DEFAULT_ADMIN_EMAIL="st.vajs@seznam.cz"
DEFAULT_ADMIN_PASSWORD="xxxxxx"

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
