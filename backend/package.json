{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run setup:local && nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "build:vercel": "npm run prisma:generate && npx prisma migrate deploy && npm run build && node dist/scripts/ensureAdmin.js",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:local": "prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:migrate:local": "prisma migrate deploy --schema prisma/sqlite/schema.prisma",
    "setup:local": "npm run prisma:generate:local && npm run prisma:migrate:local && npm run ensure:admin",
    "prisma:studio": "prisma studio",
    "prisma:studio:local": "prisma studio --schema prisma/sqlite/schema.prisma",
    "seed:translations": "ts-node src/scripts/seedTranslations.ts",
    "ensure:admin": "ts-node src/scripts/ensureAdmin.ts",
    "test:smoke": "node test-api.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  }
}
